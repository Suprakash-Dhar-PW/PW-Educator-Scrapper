# ==============================================================================
# PW-Mentor-Search Backend Environment Configuration
# ==============================================================================

# Supabase PostgreSQL Configuration
# Found under Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-publishable-key>
# Optional: Service Role key if elevated backend operations are configured
# SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Anakin Discovery & Scraping API Keys
# Required for URL scraping and search query execution
ANAKIN_API_KEY=ask_<your-anakin-api-key>
ANAKIN_SEARCH_API_KEY=ask_<your-anakin-api-key>
ANAKIN_SCRAPER_API_KEY=ask_<your-anakin-api-key>

# Search Pipeline Caching & Performance Settings
SEARCH_CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=30
